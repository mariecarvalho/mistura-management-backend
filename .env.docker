# Variáveis usadas pelo docker-compose.
# As de banco são sobrescritas pelo bloco `environment:` do compose,
# mas as outras (JWT, email, etc.) precisam estar aqui.

JWT_SECRET=TROQUE_POR_UMA_STRING_SEGURA_DE_PELO_MENOS_32_CHARS
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

NODE_ENV=production
FRONTEND_URL=http://localhost:8080

# Email (opcional — pode deixar em branco para testar sem envio de email)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Google OAuth (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/oauth/google/callback
