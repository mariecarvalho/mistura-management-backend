# ─── Banco de dados ────────────────────────────────────────────
# Quando rodando via Docker, DB_HOST deve ser "postgres" (nome do serviço).
# Quando rodando localmente (npm run dev), use "localhost".
DB_HOST=postgres
DB_PORT=5432
DB_NAME=mistura_db
DB_USER=mistura_user
DB_PASSWORD=mistura_pass

# ─── JWT ───────────────────────────────────────────────────────
# OBRIGATÓRIO: troque por uma string aleatória longa (mín. 32 chars)
JWT_SECRET=TROQUE_POR_UMA_STRING_SEGURA_DE_PELO_MENOS_32_CHARS
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

# ─── Servidor ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Frontend (usado no redirect do OAuth) ────────────────────
FRONTEND_URL=http://localhost:8080

# ─── Email (nodemailer) ────────────────────────────────────────
# Para Gmail: crie uma "Senha de app" em myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=seu-email@gmail.com
EMAIL_PASS=sua-senha-de-app

# ─── Google OAuth (opcional) ──────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/oauth/google/callback
